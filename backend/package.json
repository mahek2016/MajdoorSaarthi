{
  "name": "majdoorsaarthi-backend",
  "version": "1.0.0",
  "description": "MajdoorSaarthi API Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma --config=../prisma.config.ts",
    "db:push": "prisma db push --schema=../prisma/schema.prisma --config=../prisma.config.ts",
    "db:seed": "node ../prisma/seed.js",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
