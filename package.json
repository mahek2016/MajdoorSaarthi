{
  "name": "majdoorsaarthi",
  "private": true,
  "version": "1.0.0",
  "description": "MajdoorSaarthi monorepo root",
  "scripts": {
    "db:validate": "prisma validate --schema=./prisma/schema.prisma --config=./prisma.config.ts",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma --config=./prisma.config.ts",
    "db:push": "prisma db push --schema=./prisma/schema.prisma --config=./prisma.config.ts",
    "db:seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  }
}
